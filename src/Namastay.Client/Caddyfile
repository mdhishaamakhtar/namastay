:{$PORT:8080}

root * /srv
# Railway's edge caches pages for a day and clears them on each deploy. Browsers
# check back every time, so a new deploy shows up at once. The edge also compresses.
@pages not path /assets/* /fonts/*
header @pages Cache-Control "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400"

@assets path /assets/* /fonts/*
header @assets Cache-Control "public, max-age=31536000, immutable"

header {
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
}

# Trip pages have addresses nobody can save in advance, so they share a skeleton.
@editTrip path_regexp ^/my/[^/]+/edit$
rewrite @editTrip /shells/edit.html

@myTrip path_regexp ^/my/[^/]+$
rewrite @myTrip /shells/my-trip.html

rewrite /trip/* /shells/trip.html

try_files {path} {path}/index.html /app.html
file_server
