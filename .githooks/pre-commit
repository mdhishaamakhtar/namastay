#!/bin/sh
# Formats and lints staged F# files. `make check` lints every project.
set -e
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.fs')
[ -n "$files" ] || exit 0
dotnet fantomas $files
git add $files
echo "$files" | xargs -n 1 -P 8 dotnet dotnet-fsharplint lint --lint-config fsharplint.json
